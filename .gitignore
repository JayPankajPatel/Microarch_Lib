# pixi environments
.pixi/*
!.pixi/config.toml

# LibreLane run artifacts (regenerable; configs under blocks/*/pnr/*/config.json are tracked)
blocks/*/pnr/*/runs/

# bender dependency checkout cache (regenerable via `bender checkout`; Bender.lock is tracked)
.bender/

# SymbiYosys run-output directories: `pixi run formal` redirects all workdirs
# here via `--prefix` (see docs/adr/0010) so this one entry covers every
# module's formal task regardless of directory nesting -- pattern-matching
# by directory depth/name under blocks/*/verif/formal/ was tried first and
# rejected as fragile (a module directory name containing an underscore,
# e.g. galois_lfsr/, is indistinguishable from a generated workdir name by
# a simple glob).
/build/
*.vcd

# cocotb/Verilator build artifacts, left behind per-testbench-dir by `make`
__pycache__/
sim_build/
results.xml
